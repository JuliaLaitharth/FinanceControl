# ── Banco de dados ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://finuser:finpass@localhost:5432/assistente"

# ── JWT ─────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 64
JWT_SECRET="troque-por-um-segredo-de-no-minimo-64-caracteres-aleatorios-aqui"

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ── Pluggy ───────────────────────────────────────────────────────────────────
# Obtenha em https://dashboard.pluggy.ai  (use o sandbox para desenvolvimento)
PLUGGY_CLIENT_ID="seu-client-id-pluggy"
PLUGGY_CLIENT_SECRET="seu-client-secret-pluggy"
# Segredo para validar assinatura dos webhooks do Pluggy
PLUGGY_WEBHOOK_SECRET="seu-webhook-secret-pluggy"

# ── Criptografia em repouso (AES-256-GCM) ────────────────────────────────────
# Gere com: openssl rand -hex 32  (deve ter exatamente 64 hex chars = 32 bytes)
ENCRYPTION_KEY="troque-por-32-bytes-em-hex-64-caracteres"

# ── Firebase Cloud Messaging ─────────────────────────────────────────────────
FCM_SERVER_KEY="sua-server-key-fcm"

# ── Alexa Skill ──────────────────────────────────────────────────────────────
ALEXA_CLIENT_ID="amzn1.application-oa2-client.xxxxxxxxxxxxxxx"
ALEXA_CLIENT_SECRET="seu-client-secret-alexa"
# URL base pública da API (usado no account linking da Alexa)
API_BASE_URL="https://seu-dominio.railway.app"

# ── E-mail (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="no-reply@example.com"
SMTP_PASS="senha-smtp"
SMTP_FROM="FinanceControl <no-reply@example.com>"

# ── App ───────────────────────────────────────────────────────────────────────
PORT="3000"
NODE_ENV="development"
